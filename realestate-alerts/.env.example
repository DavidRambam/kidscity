# Where the alerts go. The easiest way to fill this in: double-click scripts\setup.bat
# (or run `python -m alerts setup`). Never commit .env - it holds passwords.

# --- Email (Gmail: create an "App password" at https://myaccount.google.com/apppasswords) ---
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- WhatsApp via CallMeBot (free, to your own number) ---
# Get the API key: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Phone in international format, e.g. +972501234567
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=

# --- Telegram (optional) ---
# 1. In Telegram, talk to @BotFather -> /newbot -> copy the token below.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
